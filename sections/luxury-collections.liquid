{% assign sid = 'lx-colgrid-' | append: section.id %}

{{ 'luxury-collections-grid.css' | asset_url | stylesheet_tag }}
{{ 'luxury-collections-grid.js' | asset_url | script_tag }}

<section
  id="{{ sid }}"
  class="lx-colgrid"
  style="

    --lx-ratio-desktop: {{ section.settings.aspect_ratio_desktop }};
    --lx-ratio-mobile: {{ section.settings.aspect_ratio_mobile }};

    --lx-pos-desktop: {{ section.settings.text_position_desktop }};
    --lx-pos-mobile: {{ section.settings.text_position_mobile }};

    --lx-offset-top-desktop: {{ section.settings.text_offset_top_desktop }}px;
    --lx-offset-bottom-desktop: {{ section.settings.text_offset_bottom_desktop }}px;
    --lx-offset-side-desktop: {{ section.settings.text_offset_side_desktop }}px;

    --lx-offset-top-mobile: {{ section.settings.text_offset_top_mobile }}px;
    --lx-offset-bottom-mobile: {{ section.settings.text_offset_bottom_mobile }}px;
    --lx-offset-side-mobile: {{ section.settings.text_offset_side_mobile }}px;

    --lx-heading-transform: {{ section.settings.heading_transform }};
    --lx-below-spacing: {{ section.settings.below_title_spacing }}px;
    --lx-below-padding: {{ section.settings.below_title_padding }}px;

    --lx-heading-bg: {{ section.settings.heading_bg }};
    --lx-heading-bg-pad: {{ section.settings.heading_bg_padding }}px;

    --lx-heading-size-desktop: {{ section.settings.heading_font_size_desktop }}px;
    --lx-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;

    --lx-subheading-size-desktop: {{ section.settings.subheading_font_size_desktop }}px;
    --lx-subheading-size-mobile: {{ section.settings.subheading_font_size_mobile }}px;

    --lx-heading-color-desktop: {{ section.settings.heading_color_desktop }};
    --lx-heading-color-mobile: {{ section.settings.heading_color_mobile }};

    --lx-subheading-color-desktop: {{ section.settings.subheading_color_desktop }};
    --lx-subheading-color-mobile: {{ section.settings.subheading_color_mobile }};

    --lx-heading-align-desktop: {{ section.settings.heading_align_desktop }};
    --lx-heading-align-mobile: {{ section.settings.heading_align_mobile }};



    --lx-card-title: {{ section.settings.card_title_color }};
    --lx-card-subtitle: {{ section.settings.card_subtitle_color }};
    --lx-card-count: {{ section.settings.card_count_color }};

    --lx-btn-text: {{ section.settings.btn_text_color }};
    --lx-btn-bg: {{ section.settings.btn_bg_color }};
    --lx-btn-border: {{ section.settings.btn_border_color }};
    --lx-btn-radius: {{ section.settings.btn_radius }}px;
    --lx-btn-border-width: {{ section.settings.btn_border_width }}px;

    --lx-bg: {{ section.settings.background_color }};
    --lx-text: {{ section.settings.text_color }};
    --lx-radius: {{ section.settings.card_radius }}px;

    --lx-gap-desktop: {{ section.settings.grid_gap_desktop }}px;
    --lx-gap-mobile: {{ section.settings.grid_gap_mobile }}px;

    --lx-side-pad-desktop: {{ section.settings.side_padding_desktop }}px;
    --lx-side-pad-mobile: {{ section.settings.side_padding_mobile }}px;


    --lx-maxw: {{ section.settings.max_width }}px;

    --lx-cols-desktop: {{ section.settings.columns_desktop }};
    --lx-cols-mobile: {{ section.settings.columns_mobile }};

    --lx-overlay: {{ section.settings.overlay_color }};
    --lx-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    --lx-hover-zoom: {{ section.settings.hover_zoom | divided_by: 100.0 }};
    --lx-hover-lift: {{ section.settings.hover_lift }}px;

    --lx-pad-top: {{ section.settings.padding_top }}px;
    --lx-pad-bot: {{ section.settings.padding_bottom }}px;
    --lx-mt: {{ section.settings.margin_top }}px;
    --lx-mb: {{ section.settings.margin_bottom }}px;

    --lx-text-pos: {{ section.settings.text_position }};
  "
    data-desktop-visible="{{ section.settings.visible_desktop }}"
    data-mobile-visible="{{ section.settings.visible_mobile }}"
    data-enable-overlay="{{ section.settings.enable_hover_overlay }}"
    data-heading-shadow="{{ section.settings.heading_shadow }}"
    data-card-shadow="{{ section.settings.card_text_shadow }}"
    data-overlay-mode="{{ section.settings.overlay_mode }}"
    data-card-style="{{ section.settings.card_style }}"
    data-section-id="{{ section.id }}"

    data-pos-desktop="{{ section.settings.text_position_desktop }}"
    data-pos-mobile="{{ section.settings.text_position_mobile }}"
    data-ratio-desktop="{{ section.settings.aspect_ratio_desktop }}"
    data-ratio-mobile="{{ section.settings.aspect_ratio_mobile }}"

    data-card-style-desktop="{{ section.settings.card_style_desktop }}"
    data-card-style-mobile="{{ section.settings.card_style_mobile }}"
>
  <div class="lx-colgrid__wrap">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lx-colgrid__header">
        {% if section.settings.heading != blank %}
          <h2 class="lx-colgrid__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="lx-colgrid__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="lx-colgrid__grid" role="list">
      {% for block in section.blocks %}
        {% assign card_type = block.settings.card_type %}
        {% assign card_title = '' %}
        {% assign card_url = '' %}
        {% assign card_image = nil %}
        {% assign card_count = nil %}

        {% if card_type == 'collection' and block.settings.collection != blank %}
          {% assign c = block.settings.collection %}
          {% assign card_title = c.title %}
          {% assign card_url = c.url %}
          {% assign card_image = c.featured_image %}
          {% assign card_count = c.all_products_count %}
        {% else %}
          {% assign card_title = block.settings.title %}
          {% assign card_url = block.settings.url %}
          {% assign card_image = block.settings.image %}
        {% endif %}

        {% if card_url == blank %}
          {% assign card_url = '#' %}
        {% endif %}

        {% assign pos = block.settings.text_position_override %}
        {% if pos == 'inherit' %}
          {% assign pos = section.settings.text_position %}
        {% endif %}

        {% assign show_count = false %}
        {% if card_type == 'collection' and block.settings.collection != blank %}
          {% if section.settings.show_product_count %}
            {% assign show_count = true %}
          {% endif %}
          {% if block.settings.show_count_override == 'show' %}
            {% assign show_count = true %}
          {% elsif block.settings.show_count_override == 'hide' %}
            {% assign show_count = false %}
          {% endif %}
        {% endif %}

        {% assign ratio = block.settings.aspect_ratio %}
        {% if ratio != blank %}
          {% assign ratio_class = 'lx-card--ratio-' | append: ratio %}
        {% else %}
          {% assign ratio_class = '' %}
        {% endif %}

        <article
          class="lx-card lx-card--pos-{{ pos }} {{ ratio_class }}"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <a class="lx-card__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
            <div class="lx-card__media">
              {% if card_image != blank %}
                <img
                  class="lx-card__img"
                  src="{{ card_image | image_url: width: 1400 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                >
              {% else %}
                <div class="lx-card__placeholder" aria-hidden="true"></div>
              {% endif %}

              <div class="lx-card__overlay" aria-hidden="true"></div>

              <div class="lx-card__content">
                <div class="lx-card__title">{{ card_title }}</div>

                {% if block.settings.subtitle != blank %}
                  <div class="lx-card__subtitle">{{ block.settings.subtitle }}</div>
                {% endif %}

                {% if show_count and card_count != blank %}
                  <div class="lx-card__count">{{ card_count }} {{ section.settings.count_suffix }}</div>
                {% endif %}
              </div>
            </div>

            {% if section.settings.title_below_image %}
              <div class="lx-card__below">
                <span class="lx-card__below-title">{{ card_title }}</span>
                {% if show_count and card_count != blank %}
                  <span class="lx-card__below-count">{{ card_count }} {{ section.settings.count_suffix }}</span>
                {% endif %}
              </div>
            {% endif %}
          </a>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="lx-colgrid__footer">
        <a class="lx-colgrid__btn lx-colgrid__btn--{{ section.settings.button_style }}" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Luxury Collections Grid",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Curated collections for every space." },

    { "type": "select", "id": "heading_transform", "label": "Heading text transform", "default": "none",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ]
    },

{ "type": "header", "content": "Typography (Desktop/Mobile)" },

{ "type": "range", "id": "heading_font_size_desktop", "label": "Heading font size - Desktop (px)", "min": 18, "max": 90, "step": 1, "default": 32 },
{ "type": "range", "id": "heading_font_size_mobile", "label": "Heading font size - Mobile (px)", "min": 16, "max": 60, "step": 1, "default": 26 },

{ "type": "range", "id": "subheading_font_size_desktop", "label": "Subheading font size - Desktop (px)", "min": 12, "max": 44, "step": 1, "default": 16 },
{ "type": "range", "id": "subheading_font_size_mobile", "label": "Subheading font size - Mobile (px)", "min": 12, "max": 40, "step": 1, "default": 14 },

{ "type": "color", "id": "heading_color_desktop", "label": "Heading color - Desktop", "default": "#111111" },
{ "type": "color", "id": "heading_color_mobile", "label": "Heading color - Mobile", "default": "#111111" },

{ "type": "color", "id": "subheading_color_desktop", "label": "Subheading color - Desktop", "default": "#555555" },
{ "type": "color", "id": "subheading_color_mobile", "label": "Subheading color - Mobile", "default": "#555555" },

{
  "type": "select",
  "id": "heading_align_desktop",
  "label": "Heading alignment - Desktop",
  "default": "left",
  "options": [
    { "value": "left", "label": "Left" },
    { "value": "center", "label": "Center" },
    { "value": "right", "label": "Right" }
  ]
},
{
  "type": "select",
  "id": "heading_align_mobile",
  "label": "Heading alignment - Mobile",
  "default": "left",
  "options": [
    { "value": "left", "label": "Left" },
    { "value": "center", "label": "Center" },
    { "value": "right", "label": "Right" }
  ]
},


    { "type": "checkbox", "id": "heading_shadow", "label": "Enable heading shadow", "default": false },
    { "type": "color", "id": "heading_bg", "label": "Heading background color", "default": "transparent" },
    { "type": "range", "id": "heading_bg_padding", "label": "Heading background padding (px)", "min": 0, "max": 20, "step": 1, "default": 0 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 980, "max": 1600, "step": 20, "default": 1320 },
    { "type": "header", "content": "Responsive Layout (Desktop/Mobile)" },

    { "type": "range", "id": "grid_gap_desktop", "label": "Grid gap - Desktop (px)", "min": 0, "max": 60, "step": 2, "default": 18 },
    { "type": "range", "id": "grid_gap_mobile", "label": "Grid gap - Mobile (px)", "min": 0, "max": 40, "step": 2, "default": 12 },

    { "type": "range", "id": "side_padding_desktop", "label": "Side padding - Desktop (px)", "min": 0, "max": 100, "step": 2, "default": 20 },
    { "type": "range", "id": "side_padding_mobile", "label": "Side padding - Mobile (px)", "min": 0, "max": 60, "step": 2, "default": 16 },
    { "type": "header", "content": "Spacing (Section)" },

    { "type": "range", "id": "margin_top", "label": "Margin top (px)", "min": 0, "max": 160, "step": 4, "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom (px)", "min": 0, "max": 160, "step": 4, "default": 0 },




    { "type": "range", "id": "columns_desktop", "label": "Columns desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Columns mobile", "min": 1, "max": 3, "step": 1, "default": 2 },

    { "type": "range", "id": "visible_desktop", "label": "Visible cards on desktop", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "visible_mobile", "label": "Visible cards on mobile", "min": 2, "max": 16, "step": 1, "default": 8 },

    { "type": "header", "content": "Card styling" },
    { "type": "range", "id": "card_radius", "label": "Card radius (px)", "min": 0, "max": 40, "step": 1, "default": 18 },


  { "type": "header", "content": "Aspect Ratio (Desktop/Mobile)" },

{
  "type": "select",
  "id": "aspect_ratio_desktop",
  "label": "Default aspect ratio - Desktop",
  "default": "4x5",
  "options": [
    { "value": "1x1", "label": "1:1" },
    { "value": "4x5", "label": "4:5" },
    { "value": "3x4", "label": "3:4" },
    { "value": "16x9", "label": "16:9" }
  ]
},
{
  "type": "select",
  "id": "aspect_ratio_mobile",
  "label": "Default aspect ratio - Mobile",
  "default": "1x1",
  "options": [
    { "value": "1x1", "label": "1:1" },
    { "value": "4x5", "label": "4:5" },
    { "value": "3x4", "label": "3:4" },
    { "value": "16x9", "label": "16:9" }
  ]
},

{ "type": "header", "content": "Card Style (Desktop/Mobile)" },

{
  "type": "select",
  "id": "card_style_desktop",
  "label": "Card style - Desktop",
  "default": "classic",
  "options": [
    { "value": "classic", "label": "Classic rectangle" },
    { "value": "soft", "label": "Soft rounded luxury" },
    { "value": "circle", "label": "Circle" },
    { "value": "diamond", "label": "Diamond" },
    { "value": "glass", "label": "Glass overlay" }
  ]
},
{
  "type": "select",
  "id": "card_style_mobile",
  "label": "Card style - Mobile",
  "default": "classic",
  "options": [
    { "value": "classic", "label": "Classic rectangle" },
    { "value": "soft", "label": "Soft rounded luxury" },
    { "value": "circle", "label": "Circle" },
    { "value": "diamond", "label": "Diamond" },
    { "value": "glass", "label": "Glass overlay" }
  ]
},

  { "type": "header", "content": "Text Position (Desktop/Mobile)" },
  {
    "type": "select",
    "id": "text_position_desktop",
    "label": "Text position - Desktop",
    "default": "bottom-center",
    "options": [
      { "value": "top-left", "label": "Top Left" },
      { "value": "top-center", "label": "Top Center" },
      { "value": "top-right", "label": "Top Right" },

      { "value": "center-left", "label": "Center Left" },
      { "value": "center", "label": "Center" },
      { "value": "center-right", "label": "Center Right" },

      { "value": "bottom-left", "label": "Bottom Left" },
      { "value": "bottom-center", "label": "Bottom Center" },
      { "value": "bottom-right", "label": "Bottom Right" }
    ]
  },
{
  "type": "select",
  "id": "text_position_mobile",
  "label": "Text position - Mobile",
  "default": "bottom-center",
  "options": [
    { "value": "top-left", "label": "Top Left" },
    { "value": "top-center", "label": "Top Center" },
    { "value": "top-right", "label": "Top Right" },

    { "value": "center-left", "label": "Center Left" },
    { "value": "center", "label": "Center" },
    { "value": "center-right", "label": "Center Right" },

    { "value": "bottom-left", "label": "Bottom Left" },
    { "value": "bottom-center", "label": "Bottom Center" },
    { "value": "bottom-right", "label": "Bottom Right" }
  ]
},

{ "type": "header", "content": "Text Offset (Desktop)" },

{ "type": "range", "id": "text_offset_top_desktop", "label": "Offset top - Desktop (px)", "min": 0, "max": 80, "step": 2, "default": 14 },
{ "type": "range", "id": "text_offset_bottom_desktop", "label": "Offset bottom - Desktop (px)", "min": 0, "max": 80, "step": 2, "default": 14 },
{ "type": "range", "id": "text_offset_side_desktop", "label": "Offset side - Desktop (px)", "min": 0, "max": 80, "step": 2, "default": 16 },

{ "type": "header", "content": "Text Offset (Mobile)" },

{ "type": "range", "id": "text_offset_top_mobile", "label": "Offset top - Mobile (px)", "min": 0, "max": 60, "step": 2, "default": 12 },
{ "type": "range", "id": "text_offset_bottom_mobile", "label": "Offset bottom - Mobile (px)", "min": 0, "max": 60, "step": 2, "default": 12 },
{ "type": "range", "id": "text_offset_side_mobile", "label": "Offset side - Mobile (px)", "min": 0, "max": 40, "step": 2, "default": 14 },




    { "type": "checkbox", "id": "enable_hover_overlay", "label": "Overlay only on hover", "default": true },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity (%)", "min": 0, "max": 90, "step": 5, "default": 45 },

    { "type": "range", "id": "hover_zoom", "label": "Hover zoom (%)", "min": 0, "max": 15, "step": 1, "default": 6 },
    { "type": "range", "id": "hover_lift", "label": "Hover lift (px)", "min": 0, "max": 14, "step": 1, "default": 4 },

    { "type": "header", "content": "Text & count" },

    { "type": "range", "id": "below_title_spacing", "label": "Below image title spacing (px)", "min": 0, "max": 40, "step": 2, "default": 14 },
    { "type": "range", "id": "below_title_padding", "label": "Below image title padding (px)", "min": 0, "max": 30, "step": 2, "default": 0 },
    { "type": "color", "id": "card_title_color", "label": "Card title color", "default": "#FFFFFF" },
    { "type": "color", "id": "card_subtitle_color", "label": "Card subtitle color", "default": "#FFFFFF" },
    { "type": "color", "id": "card_count_color", "label": "Card count color", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "card_text_shadow", "label": "Enable card text shadow", "default": true },
    {
  "type": "select",
  "id": "overlay_mode",
  "label": "Overlay behavior",
  "default": "hover",
  "options": [
    { "value": "none", "label": "No overlay" },
    { "value": "hover", "label": "On hover only" },
    { "value": "always", "label": "Always visible" }
      ]
    },

    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count (collections)", "default": true },
    { "type": "text", "id": "count_suffix", "label": "Count suffix", "default": "products" },
    { "type": "checkbox", "id": "title_below_image", "label": "Also show title below image", "default": false },



    { "type": "header", "content": "Section styling" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "transparent" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 140, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 140, "step": 4, "default": 60 },

    { "type": "header", "content": "Button" },

    { "type": "color", "id": "btn_text_color", "label": "Button text color", "default": "#111111" },
    { "type": "color", "id": "btn_bg_color", "label": "Button background color", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_border_color", "label": "Button border color", "default": "#111111" },
    { "type": "range", "id": "btn_radius", "label": "Button radius (px)", "min": 0, "max": 50, "step": 1, "default": 30 },
    { "type": "range", "id": "btn_border_width", "label": "Button border width (px)", "min": 0, "max": 5, "step": 1, "default": 1 },


    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all collections" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "outline",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "card_type",
          "label": "Card type",
          "default": "collection",
          "options": [
            { "value": "collection", "label": "Collection" },
            { "value": "custom", "label": "Custom" }
          ]
        },
        { "type": "collection", "id": "collection", "label": "Collection" },

        { "type": "image_picker", "id": "image", "label": "Custom image (for custom type)" },
        { "type": "text", "id": "title", "label": "Custom title (for custom type)" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (optional)" },
        { "type": "url", "id": "url", "label": "Custom link (for custom type)" },

        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect ratio (override)",
          "default": "",
          "options": [
            { "value": "", "label": "Use section default" },
            { "value": "1x1", "label": "1:1" },
            { "value": "4x5", "label": "4:5" },
            { "value": "3x4", "label": "3:4" },
            { "value": "16x9", "label": "16:9" }
          ]
        },

        {
          "type": "select",
          "id": "text_position_override",
          "label": "Text position (override)",
          "default": "inherit",
          "options": [
            { "value": "inherit", "label": "Use section default" },
            { "value": "top", "label": "Top" },
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ]
        },

        {
          "type": "select",
          "id": "show_count_override",
          "label": "Product count (override)",
          "default": "inherit",
          "options": [
            { "value": "inherit", "label": "Use section setting" },
            { "value": "show", "label": "Force show" },
            { "value": "hide", "label": "Force hide" }
          ]
        }
      ]
    }
  ],
  "presets": [
    { "name": "Luxury Collections Grid", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }
  ]
}
{% endschema %}